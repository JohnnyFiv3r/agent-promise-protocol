        "purpose": {
          "enum": [
            "authorization",
            "payment",
            "commerce",
            "order_validation"
          ]
        },
        "native_protocol": {
          "$ref": "#/$defs/native_protocol"
        },
        "native_subject_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/native_evidence_ref"
          }
        },
        "finalized_agreement_ref": {
          "$ref": "#/$defs/content_ref"
        },
        "selected_route_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "order_validation_binding_ref": {
          "$ref": "#/$defs/content_ref"
        }
      },
      "required": [
        "agreement_digest",
        "subject_id",
        "action_id",
        "purpose",
        "native_protocol",
        "native_subject_ref",
        "evidence_refs",
        "finalized_agreement_ref"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "enum": [
                  "order_validation",
                  "payment",
                  "commerce"
                ]
              }
            }
          },
          "then": {
            "required": [
              "selected_route_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "payment"
              }
            }
          },
          "then": {
            "required": [
              "order_validation_binding_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "order_validation"
              }
            }
          },
          "then": {
            "properties": {
              "native_protocol": {
                "$ref": "#/$defs/ap2_profile"
              }
            }
          }
        }
      ]
