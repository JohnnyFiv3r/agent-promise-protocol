      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agreement_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
