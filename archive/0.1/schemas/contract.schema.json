{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-bazaar:draft:0.1:semantic-records",
  "title": "Agent Bazaar A2A extension semantic records",
  "description": "Semantic record schemas for the A2A extension. Native A2A, MCP, authorization and payment mechanisms retain their own wire formats and verification. External bindings reference native evidence and grant no authority.",
  "oneOf": [
    {
      "$ref": "#/$defs/publication_contract"
    },
    {
      "$ref": "#/$defs/intent"
    },
    {
      "$ref": "#/$defs/reception_permit"
    },
    {
      "$ref": "#/$defs/offer"
    },
    {
      "$ref": "#/$defs/promise_issued"
    },
    {
      "$ref": "#/$defs/agreement_terms"
    },
    {
      "$ref": "#/$defs/external_binding"
    },
    {
      "$ref": "#/$defs/delivery"
    }
  ],
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "assessor_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "check_at": {
          "enum": [
            "adoption",
            "finalization",
            "before_action",
            "assessment"
          ]
        }
      },
      "required": [
        "id",
        "meaning",
        "assessor_agent_id",
        "evidence_required",
        "check_at"
      ]
    },
    "promise_description": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "promiser_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "performer_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "promisee_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "polarity": {
          "enum": [
            "provide",
            "receive"
          ]
        },
        "behavior_type": {
          "type": "string",
          "minLength": 1
        },
        "behavior": {
          "type": "string",
          "minLength": 1
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "minItems": 0
        },
        "assessment_method": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "promiser_agent_id",
        "performer_agent_id",
        "promisee_ids",
        "polarity",
        "behavior_type",
        "behavior",
        "limits",
        "conditions",
        "assessment_method"
      ]
    },
    "settlement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "none"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "simulated"
            },
            "currency": {
              "const": "USD"
            },
            "amount_minor": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "minor_unit_exponent": {
              "const": 2
            },
            "creates_payment_authority": {
              "const": false
            }
          },
          "required": [
            "mode",
            "currency",
            "amount_minor",
            "minor_unit_exponent",
            "creates_payment_authority"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "external"
            },
            "native_protocol": {
              "$ref": "#/$defs/native_protocol"
            },
            "native_contract_ref": {
              "type": "string",
              "minLength": 1
            },
            "native_contract_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "trigger": {
              "enum": [
                "before_fulfillment",
                "at_milestone",
                "after_delivery_acceptance",
                "native_flow"
              ]
            },
            "trigger_definition": {
              "type": "string",
              "minLength": 1
            },
            "payee_agent_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mode",
            "native_protocol",
            "native_contract_ref",
            "native_contract_digest",
            "trigger",
            "trigger_definition",
            "payee_agent_id"
          ]
        }
      ]
    },
    "intent_body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intent_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "previous_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "semantics": {
          "const": "interest_declaration"
        },
        "market_posture": {
          "enum": [
            "seek_result",
            "seek_work",
            "seek_collaboration"
          ]
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "desired_outcome": {
          "type": "string",
          "minLength": 1
        },
        "preferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "disclosure_audience": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "publication_contract_ref": {
          "$ref": "#/$defs/content_ref"
        }
      },
      "required": [
        "intent_id",
        "revision",
        "previous_digest",
        "semantics",
        "market_posture",
        "topic",
        "desired_outcome",
        "preferences",
        "disclosure_audience",
        "expires_at",
        "publication_contract_ref"
      ]
    },
    "permit_body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permit_id": {
          "type": "string",
          "minLength": 1
        },
        "channel_id": {
          "type": "string",
          "minLength": 1
        },
        "recipient_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "sender_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "intent_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "allowed_message_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "offer",
              "clarification"
            ]
          },
          "minItems": 1
        },
        "sequence_start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sequence_end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_offer_versions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_message_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "min_interval_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "control_allowance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "close": {
              "const": 1
            },
            "close_ack": {
              "const": 1
            },
            "formation_status_messages": {
              "const": 8
            },
            "formation_status_max_bytes": {
              "const": 32768
            },
            "formation_status_max_message_bytes": {
              "const": 4096
            },
            "close_max_message_bytes": {
              "const": 1024
            }
          },
          "required": [
            "close",
            "close_ack",
            "close_max_message_bytes",
            "formation_status_messages",
            "formation_status_max_bytes",
            "formation_status_max_message_bytes"
          ]
        }
      },
      "required": [
        "permit_id",
        "channel_id",
        "recipient_agent_id",
        "sender_agent_id",
        "intent_digest",
        "topic",
        "allowed_message_kinds",
        "sequence_start",
        "sequence_end",
        "max_offer_versions",
        "max_message_bytes",
        "max_total_bytes",
        "min_interval_seconds",
        "expires_at",
        "policy_epoch",
        "control_allowance"
      ]
    },
    "offer_body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "type": "string",
          "minLength": 1
        },
        "offer_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "previous_offer_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "based_on_peer_offer_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "settlement": {
          "$ref": "#/$defs/settlement"
        },
        "own_promise_proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/promise_description"
          },
          "minItems": 1
        },
        "requested_counterpromises": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/promise_description"
          },
          "minItems": 0
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "publication_contract_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_ref"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "commercial_route_selection": {
          "$ref": "#/$defs/commercial_route_selection"
        },
        "offering": {
          "$ref": "#/$defs/offering"
        },
        "performance_terms_ref": {
          "$ref": "#/$defs/content_ref"
        }
      },
      "required": [
        "channel_id",
        "offer_sequence",
        "previous_offer_digest",
        "based_on_peer_offer_digest",
        "valid_until",
        "settlement",
        "own_promise_proposals",
        "requested_counterpromises",
        "exclusions",
        "publication_contract_refs",
        "commercial_route_selection",
        "offering",
        "performance_terms_ref"
      ]
    },
    "promise_body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "$ref": "#/$defs/promise_description"
        },
        "adoption_authority_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "disclosure_audience": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "description",
        "adoption_authority_refs",
        "valid_until",
        "disclosure_audience"
      ]
    },
    "terms_body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agreement_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "const": "candidate"
        },
        "procurement_slot_id": {
          "type": "string",
          "minLength": 1
        },
        "buyer_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "offer_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "minItems": 2
        },
        "promises": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/promise_description"
          },
          "minItems": 2
        },
        "settlement": {
          "$ref": "#/$defs/settlement"
        },
        "data_policy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "cancellation_policy": {
          "type": "string",
          "minLength": 1
        },
        "required_features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "publication_contract_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_ref"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "commercial_route_selection": {
          "$ref": "#/$defs/commercial_route_selection"
        },
        "offering": {
          "$ref": "#/$defs/offering"
        },
        "performance_terms": {
          "$ref": "#/$defs/performance_terms"
        },
        "formation_profile": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "agreement_id",
        "stage",
        "buyer_agent_id",
        "provider_agent_id",
        "offer_digests",
        "promises",
        "settlement",
        "data_policy",
        "cancellation_policy",
        "required_features",
        "publication_contract_refs",
        "commercial_route_selection",
        "offering",
        "performance_terms",
        "formation_profile"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "formation_profile": {
                "const": "https://example.org/extensions/agent-bazaar/profiles/bilateral/v0.1"
              }
            }
          },
          "then": {
            "required": [
              "procurement_slot_id"
            ]
          }
        }
      ]
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "locator": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "digest",
        "locator"
