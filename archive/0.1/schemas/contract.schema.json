            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "source_evidence_artifact_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "agreement_digest",
        "execution_id",
        "input_digest",
        "artifacts",
        "limitations",
        "effects"
      ]
    },
    "intent": {
      "type": "object",
