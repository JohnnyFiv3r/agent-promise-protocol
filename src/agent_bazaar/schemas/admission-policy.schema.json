{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": "abp/admission-policy/0.4-draft"
    },
    "kind": {
      "const": "admission_policy_declaration"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "issuer_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "issuer_principal_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "recipient_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "recipient_scope_id": {
      "type": "string",
      "minLength": 1
    },
    "accounting_authority_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_ref": {
      "$ref": "urn:agent-bazaar:draft:0.4:semantic-records#/$defs/content_ref"
    },
    "eligibility_ref": {
      "$ref": "urn:agent-bazaar:draft:0.4:semantic-records#/$defs/content_ref"
    },
    "status_policy_ref": {
      "$ref": "urn:agent-bazaar:draft:0.4:semantic-records#/$defs/content_ref"
    },
    "status_ref": {
      "type": "string",
      "format": "uri"
    },
    "validity": {
      "$ref": "urn:agent-bazaar:draft:0.4:semantic-records#/$defs/validity"
    },
    "recovery_policy_ref": {
      "$ref": "urn:agent-bazaar:draft:0.4:semantic-records#/$defs/content_ref"
    },
    "reply_max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "pools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allowance_id": {
            "type": "string",
            "minLength": 1
          },
          "traffic_class": {
            "enum": [
              "negotiation",
              "control"
            ]
          },
          "record_kinds": {
            "type": "array",
            "items": {
              "$ref": "urn:agent-bazaar:draft:0.4:semantic-records#/$defs/semantic_kind"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "max_messages": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "max_work_units": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "work_semantics_ref": {
            "$ref": "urn:agent-bazaar:draft:0.4:semantic-records#/$defs/content_ref"
          },
          "max_in_flight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "max_live_options": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "validity": {
            "$ref": "urn:agent-bazaar:draft:0.4:semantic-records#/$defs/validity"
          },
          "replenishment": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "const": "none"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "const": "policy_defined"
                  },
                  "rule_ref": {
                    "$ref": "urn:agent-bazaar:draft:0.4:semantic-records#/$defs/content_ref"
                  }
                },
                "required": [
                  "mode",
                  "rule_ref"
                ]
              }
            ]
          },
          "operation_purposes": {
            "type": "array",
            "items": {
              "$ref": "urn:agent-bazaar:draft:0.4:semantic-records#/$defs/operation_purpose"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "allowance_id",
          "traffic_class",
          "record_kinds",
          "max_messages",
          "max_bytes",
          "max_work_units",
          "work_semantics_ref",
          "max_in_flight",
          "max_live_options",
          "validity",
          "replenishment",
          "operation_purposes"
        ]
      },
      "minItems": 2,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "properties": {
              "traffic_class": {
                "const": "negotiation"
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "traffic_class": {
                "const": "control"
              }
            }
          }
        }
      ]
    },
    "proofs": {
      "type": "array",
      "items": {
        "$ref": "urn:agent-bazaar:draft:0.4:semantic-records#/$defs/proof_reference"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "profile",
    "kind",
    "id",
    "issuer_agent_id",
    "issuer_principal_id",
    "created_at",
    "recipient_agent_id",
    "recipient_scope_id",
    "accounting_authority_id",
    "authority_ref",
    "eligibility_ref",
    "status_policy_ref",
    "status_ref",
    "validity",
    "recovery_policy_ref",
    "reply_max_bytes",
    "pools",
    "proofs"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-bazaar:draft:0.4:admission-policy",
  "title": "Agent Bazaar 0.4 admission policy disclosure",
  "description": "Machine-readable declaration of selected existing admission policy. Values and renewal are policy choices. Native authority and proof must authenticate this content. C1/C3 supply normative cross-field, issuer, purpose and enforcement requirements."
}
